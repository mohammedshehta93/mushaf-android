  "intentions": [
    {"t": "أقرأ القرآن عبادةً لله وتقربًا إليه، ابتغاء وجهه وحده.", "ref": {"ayah": "35:29"}},
    {"t": "أرجو الأجر: بكل حرف حسنة، والحسنة بعشر أمثالها.", "ref": {"riyad": 41385}},
    {"t": "أنوي أن أتدبر ما أقرأ وأفهمه، ليزداد إيماني.", "ref": {"ayah": "38:29"}},
    {"t": "أنوي العمل بما أقرأ، والتخلق بأخلاق القرآن.", "ref": {"riyad": 41378}},
    {"t": "أطلب الهداية من كلام الله، فهو يهدي للتي هي أقوم.", "ref": {"ayah": "17:9"}},
    {"t": "أنوي الاستشفاء به لقلبي وبدني.", "ref": {"ayah": "17:82"}},
    {"t": "أرجو أن يكون شفيعًا لي يوم القيامة، وحجة لي لا عليّ.", "ref": {"riyad": 41377}},
    {"t": "أنوي حفظه ومراجعته وتعاهده حتى لا يتفلت مني.", "ref": {"riyad": 41388}},
    {"t": "أنوي أن أتعلمه وأعلّمه غيري.", "ref": {"riyad": 41379}},
    {"t": "أنوي أن يعمر بيتي بذكر الله ويطرد عنه الشيطان.", "ref": {"riyad": 41404}}
  ],
