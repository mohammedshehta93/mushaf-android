<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="12dp" android:gravity="center"
    android:layoutDirection="rtl" android:background="@drawable/widget_bg">
    <ImageView android:id="@+id/w_ayah" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:scaleType="fitCenter" android:contentDescription="آية اليوم" />
    <TextView android:id="@+id/w_ref" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:textSize="12sp" android:textColor="@color/widget_accent" />
</LinearLayout>
