<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="14dp" android:gravity="center_vertical"
    android:layoutDirection="rtl" android:background="@drawable/widget_bg">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="تابع القراءة" android:textSize="12sp" android:textColor="@color/widget_accent" />
    <TextView android:id="@+id/w_title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="19sp" android:textStyle="bold" android:textColor="@color/widget_ink" android:maxLines="1" />
    <TextView android:id="@+id/w_sub" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="13sp" android:textColor="@color/widget_sub" android:maxLines="1" />
    <ProgressBar android:id="@+id/w_progress" style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="8dp"
        android:progressTint="@color/widget_accent" android:max="1" android:progress="0" />
    <TextView android:id="@+id/w_wird" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:textSize="12sp" android:textColor="@color/widget_sub" android:maxLines="1" />
</LinearLayout>
